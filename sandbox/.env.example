# Copy to the REPO ROOT as .env (HACKUTA/.env). Never commit the real file.
DATABASE_URL=postgres://user:pass@host:5432/db
# PGSSL=off            # only for a local Postgres without TLS

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto = live Gemini, cache on failure/timeout | live = Gemini only | cache = always cached (stage demo)
COACHING_MODE=auto
COACHING_TIMEOUT_MS=45000
COACHING_CACHE_DELAY_MS=2500

FACEIT_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Where seeded demo clips are served from (sandbox serves sandbox/demo-clips/)
DEMO_CLIP_BASE=http://localhost:3001/demo-clips
