# Copy to .env and fill in server-side credentials. Never use a VITE_ prefix for secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=3001
# production on Railway: secure session cookie (Express also serves web/dist when it has been built)
NODE_ENV=development

# Clip storage (S3-compatible, direct browser uploads via presigned URLs)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CS2 stats (FACEIT Data API v4)
FACEIT_API_KEY=
# mock = generated FACEIT data (default when no key) | live = real FACEIT API, mock on failure
FACEIT_MODE=mock

# Where seeded demo clips are served from (server/demo-clips/)
DEMO_CLIP_BASE=http://localhost:3001/demo-clips

# Real data sources (S6, each falls back to mock/seeded data when unset or failing)
# FaZe match schedule / live status for the Home banner
PANDASCORE_TOKEN=
# FaZe videos + live streams (Home, Community Watch rooms)
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Steam profile link (avatar, CS2 hours)
STEAM_API_KEY=
