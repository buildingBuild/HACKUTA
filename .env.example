# Copy to .env and fill in server-side credentials. Never use a VITE_ prefix for secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=3001

# Clip storage (S3-compatible, direct browser uploads via presigned URLs)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Coaching and CS2 stats
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto = demo clips use their saved report, other clips live Gemini (saved report on failure) | live = Gemini for everything | cache = always saved (stage demo)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_ATTEMPT_TIMEOUT_MS=20000
COACHING_MODE=auto
COACHING_TIMEOUT_MS=60000
COACHING_CACHE_DELAY_MS=2500
FACEIT_API_KEY=
# mock = generated FACEIT data (default when no key) | live = real FACEIT API, mock on failure
FACEIT_MODE=mock

# Voice coach and briefings (agent setup: server/src/lib/voice/AGENT_SETUP.md)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Where seeded demo clips are served from (server/demo-clips/)
DEMO_CLIP_BASE=http://localhost:3001/demo-clips

# Optional social integrations
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
