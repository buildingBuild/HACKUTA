# Copy to .env and fill in server-side credentials. Never use a VITE_ prefix for secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=3001

# Clip storage (S3-compatible, direct browser uploads via presigned URLs)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CS2 stats (FACEIT Data API v4)
FACEIT_API_KEY=
# mock = generated FACEIT data (default when no key) | live = real FACEIT API, mock on failure
FACEIT_MODE=mock

# Where seeded demo clips are served from (server/demo-clips/)
DEMO_CLIP_BASE=http://localhost:3001/demo-clips

# Optional social integrations
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
